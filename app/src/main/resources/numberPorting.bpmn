<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  id="Definitions_numberPorting"
                  targetNamespace="http://example.com/telco/number-porting">

  <bpmn:error id="Error_PortingRejected" name="Porting rejected" errorCode="PORTING_REJECTED" />

  <bpmn:process id="numberPorting" name="Number porting" isExecutable="true" camunda:historyTimeToLive="P30D">

    <bpmn:startEvent id="portingRequested" name="Porting request received">
      <bpmn:outgoing>Flow_toValidate</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="validateRequest" name="Validate porting request"
                      camunda:class="com.example.telco.ValidatePortingRequestDelegate">
      <bpmn:incoming>Flow_toValidate</bpmn:incoming>
      <bpmn:outgoing>Flow_toProvision</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:boundaryEvent id="requestRejected" name="Request rejected" attachedToRef="validateRequest">
      <bpmn:outgoing>Flow_toNotify</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_rejected" errorRef="Error_PortingRejected" />
    </bpmn:boundaryEvent>

    <bpmn:serviceTask id="notifyRejected" name="Notify customer: rejected"
                      camunda:class="com.example.telco.NotifyRejectionDelegate">
      <bpmn:incoming>Flow_toNotify</bpmn:incoming>
      <bpmn:outgoing>Flow_toRejectedEnd</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="portingRejected" name="Porting rejected">
      <bpmn:incoming>Flow_toRejectedEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="provisionHss" name="Provision number in HSS" camunda:asyncBefore="true"
                      camunda:class="com.example.telco.ProvisionHssDelegate">
      <bpmn:extensionElements>
        <camunda:failedJobRetryTimeCycle>R3/PT10S</camunda:failedJobRetryTimeCycle>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_toProvision</bpmn:incoming>
      <bpmn:outgoing>Flow_toWait</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:intermediateCatchEvent id="waitForDonorWindow" name="Wait for donor operator window">
      <bpmn:incoming>Flow_toWait</bpmn:incoming>
      <bpmn:outgoing>Flow_toActivate</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_donorWindow">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${waitDuration}</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>

    <bpmn:serviceTask id="activateNumber" name="Activate number" camunda:asyncBefore="true"
                      camunda:class="com.example.telco.ActivateNumberDelegate">
      <bpmn:extensionElements>
        <camunda:failedJobRetryTimeCycle>R5/PT10S</camunda:failedJobRetryTimeCycle>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_toActivate</bpmn:incoming>
      <bpmn:outgoing>Flow_toPortedEnd</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="numberPorted" name="Number ported">
      <bpmn:incoming>Flow_toPortedEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_toValidate" sourceRef="portingRequested" targetRef="validateRequest" />
    <bpmn:sequenceFlow id="Flow_toProvision" sourceRef="validateRequest" targetRef="provisionHss" />
    <bpmn:sequenceFlow id="Flow_toWait" sourceRef="provisionHss" targetRef="waitForDonorWindow" />
    <bpmn:sequenceFlow id="Flow_toActivate" sourceRef="waitForDonorWindow" targetRef="activateNumber" />
    <bpmn:sequenceFlow id="Flow_toPortedEnd" sourceRef="activateNumber" targetRef="numberPorted" />
    <bpmn:sequenceFlow id="Flow_toNotify" sourceRef="requestRejected" targetRef="notifyRejected" />
    <bpmn:sequenceFlow id="Flow_toRejectedEnd" sourceRef="notifyRejected" targetRef="portingRejected" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_numberPorting">
    <bpmndi:BPMNPlane id="BPMNPlane_numberPorting" bpmnElement="numberPorting">
      <bpmndi:BPMNShape id="portingRequested_di" bpmnElement="portingRequested">
        <dc:Bounds x="172" y="200" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="150" y="243" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="validateRequest_di" bpmnElement="validateRequest">
        <dc:Bounds x="260" y="178" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="provisionHss_di" bpmnElement="provisionHss">
        <dc:Bounds x="420" y="178" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="waitForDonorWindow_di" bpmnElement="waitForDonorWindow">
        <dc:Bounds x="582" y="200" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="555" y="243" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="activateNumber_di" bpmnElement="activateNumber">
        <dc:Bounds x="670" y="178" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="numberPorted_di" bpmnElement="numberPorted">
        <dc:Bounds x="832" y="200" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="815" y="243" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="notifyRejected_di" bpmnElement="notifyRejected">
        <dc:Bounds x="420" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="portingRejected_di" bpmnElement="portingRejected">
        <dc:Bounds x="582" y="322" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="560" y="365" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="requestRejected_di" bpmnElement="requestRejected">
        <dc:Bounds x="292" y="240" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="222" y="283" width="84" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_toValidate_di" bpmnElement="Flow_toValidate">
        <di:waypoint x="208" y="218" />
        <di:waypoint x="260" y="218" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_toProvision_di" bpmnElement="Flow_toProvision">
        <di:waypoint x="360" y="218" />
        <di:waypoint x="420" y="218" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_toWait_di" bpmnElement="Flow_toWait">
        <di:waypoint x="520" y="218" />
        <di:waypoint x="582" y="218" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_toActivate_di" bpmnElement="Flow_toActivate">
        <di:waypoint x="618" y="218" />
        <di:waypoint x="670" y="218" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_toPortedEnd_di" bpmnElement="Flow_toPortedEnd">
        <di:waypoint x="770" y="218" />
        <di:waypoint x="832" y="218" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_toNotify_di" bpmnElement="Flow_toNotify">
        <di:waypoint x="310" y="276" />
        <di:waypoint x="310" y="340" />
        <di:waypoint x="420" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_toRejectedEnd_di" bpmnElement="Flow_toRejectedEnd">
        <di:waypoint x="520" y="340" />
        <di:waypoint x="582" y="340" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
